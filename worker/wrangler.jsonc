// Cloudflare Workers configuration for the MSCC Quotation System.
// The website is the same build as the PC version (../dist); /api/* runs src/index.js.
{
  "name": "mscc-quotation",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mscc",
      // Created on 2026-11-16 (region EEUR) for https://mscc.dpdns.org
      "database_id": "35f37b81-2345-4713-9b47-26ceca734f79",
      "migrations_dir": "migrations"
    }
  ],
  // The public address (v2.0.0). Replaced the named tunnel, which pointed at the office PC.
  "routes": [{ "pattern": "mscc.dpdns.org", "custom_domain": true }],
  "workers_dev": true, // keeps https://mscc-quotation.mscc-quotation-worker.workers.dev as a second address
  "observability": { "enabled": true }
}
